# Published image: latest, sha-<full-commit>, or an immutable digest.
CHRISTMAS_IMAGE=ghcr.io/wjdecorte/christmas:latest
# Choose a strong administrator password, at least 12 characters. No default.
ADMIN_PASSWORD=
# Or set an Argon2 hash (single-quote it to preserve $ signs) and leave password empty.
ADMIN_PASSWORD_HASH=
PORT=8090
# Optional: bind to the NAS's LAN IPv4 address instead of every interface.
BIND_ADDRESS=0.0.0.0
DATA_DIR=/volume1/docker/christmas-events
APP_UID=1000
APP_GID=1000
# Use true only when serving via HTTPS; LAN HTTP requires false.
COOKIE_SECURE=false
# Identify the app and include your contact before requesting geocoding.
GEOCODER_USER_AGENT=NorthGeorgiaHolidayEvents/1.0 (contact: your-email)
GEOCODER_URL=https://nominatim.openstreetmap.org/search
